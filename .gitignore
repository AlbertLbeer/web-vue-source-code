# 依赖目录（核心，绝对不上传，体积大且可自动安装）
node_modules/

# 构建产物（执行 npm run build 后生成的目录）
dist/
dist-ssr/
build/

# 本地环境变量（通常包含敏感信息如账号密码，绝对不上传）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器/IDE 配置（因人而异，容易引发合并冲突）
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 操作系统垃圾文件
.DS_Store
Thumbs.db
desktop.ini

# 临时/缓存文件
*.local
*.log
.cache/
.temp/